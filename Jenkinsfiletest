pipeline {
    agent any

    stages {
        stage("Build") {
            agent {
                docker {
                    image 'node:18-alpine'
                    reuseNode true
                }
            }
        }

        stage("Test") {
            sh '''
               echo "Start Test!!!"
               ls -al
               node --version
               npm --version
               npm ci
               npm run build
               cd build 
               ls -al
               test index.html
               echo "End Test!!!"  
            '''
        }
    }

    post {
        success {
            archiveArtifacts artifacts: "**"
        }
    }
}